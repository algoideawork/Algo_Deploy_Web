# PostgreSQL Database Connection URL (Compatible with Neon, Supabase, Vercel Postgres, AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/algodeploy?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/algodeploy?schema=public"

# AES-256 Encryption Key (32 bytes hex or string) used to encrypt broker API credentials & TOTP seeds in DB
ENCRYPTION_SECRET_KEY="c4f8a12398b76543210fedcba0987654c4f8a12398b76543210fedcba0987654"

# Application Base URL (Used for Webhook URLs and Broker OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret token for admin endpoints
ADMIN_SECRET="algo-deploy-admin-secret-key-change-in-production"
