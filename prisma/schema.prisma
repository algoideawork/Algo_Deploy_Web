datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  TRADER
  LEADER
  ADMIN
}

enum BrokerType {
  DHAN
  ZERODHA
  ANGEL_ONE
}

enum ExecutionStatus {
  PENDING
  SUCCESS
  REJECTED
  CANCELLED
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  role           Role            @default(TRADER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  brokerAccounts BrokerAccount[]
  strategies     Strategy[]
  subscriptions  Subscription[]
}

model BrokerAccount {
  id              String           @id @default(cuid())
  userId          String
  name            String           // e.g., "My Primary Dhan", "Zerodha Kite Algo"
  broker          BrokerType
  clientId        String           // Broker User ID / Client Code (e.g. '1100345678')
  apiKey          String           // Encrypted (AES-256)
  apiSecret       String?          // Encrypted (AES-256, for Zerodha / Angel)
  pin             String?          // Encrypted (MPIN for Angel One / Zerodha)
  totpSecret      String?          // Encrypted (Base32 TOTP secret for Angel automated login)
  accessToken     String?          // Encrypted active access token
  tokenExpiry     DateTime?
  isActive        Boolean          @default(true)
  isLiveTrading   Boolean          @default(true) // true = Real execution, false = Paper Trading
  lastSyncAt      DateTime?
  lastSyncStatus  String?          // "SUCCESS", "FAILED", "EXPIRED"
  errorMessage    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]
  executions      OrderExecution[]

  @@index([userId])
}

model Strategy {
  id                     String           @id @default(cuid())
  userId                 String
  name                   String
  description            String?
  symbol                 String?          // e.g. "NIFTY", "BANKNIFTY", "RELIANCE"
  exchange               String           @default("NSE") // NSE, NFO, BSE, MCX
  webhookToken           String           @unique // Unique secret token for endpoint /api/v1/webhook/[token]
  isPublic               Boolean          @default(false)
  isLive                 Boolean          @default(true)
  riskMultiplierDefault  Float            @default(1.0)
  tags                   String[]         @default([])
  winRate                Float            @default(0.0)
  roi                    Float            @default(0.0)
  maxDrawdown            Float            @default(0.0)
  totalTrades            Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions          Subscription[]
  signals                SignalLog[]
  executions             OrderExecution[]

  @@index([userId])
  @@index([webhookToken])
}

model Subscription {
  id              String        @id @default(cuid())
  userId          String
  strategyId      String
  brokerAccountId String
  multiplier      Float         @default(1.0) // Sizing multiplier (e.g., 2.0 = 2x qty)
  maxLots         Int?          // Optional safety cap on lot size
  maxDailyLoss    Float?        // In INR, stops trading if reached
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy        Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  brokerAccount   BrokerAccount @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@unique([strategyId, brokerAccountId])
  @@index([strategyId])
  @@index([brokerAccountId])
}

model SignalLog {
  id             String           @id @default(cuid())
  strategyId     String
  rawPayload     Json
  action         String           // BUY, SELL, SQUAREOFF
  symbol         String
  orderType      String           @default("MARKET") // MARKET, LIMIT
  price          Float?
  receivedAt     DateTime         @default(now())
  status         String           @default("PROCESSED") // PROCESSED, PARTIAL, FAILED
  totalAccounts  Int              @default(0)
  successCount   Int              @default(0)
  failedCount    Int              @default(0)

  strategy       Strategy         @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  executions     OrderExecution[]

  @@index([strategyId])
  @@index([receivedAt])
}

model OrderExecution {
  id              String          @id @default(cuid())
  signalLogId     String
  strategyId      String
  brokerAccountId String
  broker          BrokerType
  symbol          String
  transactionType String          // BUY, SELL
  productType     String          @default("MIS") // MIS (Intraday), CNC (Delivery), NRML (F&O)
  orderType       String          @default("MARKET") // MARKET, LIMIT, SL, SL_M
  quantity        Int
  price           Float?
  status          ExecutionStatus @default(PENDING)
  brokerOrderId   String?
  rejectionReason String?
  latencyMs       Int?
  executedAt      DateTime?
  createdAt       DateTime        @default(now())

  signalLog       SignalLog       @relation(fields: [signalLogId], references: [id], onDelete: Cascade)
  strategy        Strategy        @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  brokerAccount   BrokerAccount   @relation(fields: [brokerAccountId], references: [id], onDelete: Cascade)

  @@index([signalLogId])
  @@index([strategyId])
  @@index([brokerAccountId])
  @@index([createdAt])
}

